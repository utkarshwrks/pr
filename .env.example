# Copy to .env.local for development; set the same variables in your host for production.
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# Public origin of the live site, no trailing slash. Enables canonical URLs,
# absolute Open Graph URLs, sitemap.xml and Organization structured data.
NEXT_PUBLIC_SITE_URL=

# Consultation booking link (Calendly, Cal.com, …). Leave empty to route
# "Book a consultation" buttons to the enquiry form instead.
NEXT_PUBLIC_BOOKING_URL=

# PostgreSQL connection string for storing enquiries. Until this is set the
# enquiry form tells visitors it is unavailable rather than pretending to send.
DATABASE_URL=
# Only if the URL has no sslmode: "true" (verify certificate) or "no-verify".
DATABASE_SSL=
# Optional: maximum pooled connections per server instance (default 5).
DATABASE_POOL_MAX=

# Lead review screen at /admin. Use a long, unique password.
ADMIN_PASSWORD=
# Random 32+ character string used to sign admin sessions: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Random string used to hash visitor IP addresses for rate limiting: openssl rand -hex 32
IP_HASH_SECRET=

# Optional: POST a JSON summary of each new enquiry here (Slack incoming
# webhook, Zapier/Make hook, CRM endpoint).
LEAD_WEBHOOK_URL=
